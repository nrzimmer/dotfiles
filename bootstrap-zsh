#!/usr/bin/env bash

# bootstrap-zsh: provision a fresh machine to use this repo's zsh config.
#
# This does NOT install system packages — providing the tools below is on you.
# It will:
#   1. check the tools this repo's zsh setup expects and report what's missing
#   2. install oh-my-zsh (unattended, keeping this repo's .zshrc)
#   3. install the powerlevel10k theme into oh-my-zsh's custom dir
#   4. link every dotfile via ./dotfiles setup
#   5. tell you how to make zsh your login shell, if it isn't already

set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH/custom}"

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; }

# ---------- 1. tool check ----------
# Tools required to run this bootstrap itself.
required_tools=(zsh git curl)
# Tools referenced by .zshrc / .aliases that the shell expects at runtime.
# (oh-my-zsh plugins gitfast and sudo are built in and need nothing extra.)
config_tools=(fastfetch zoxide envwalk docker composer)

missing_required=()
for t in "${required_tools[@]}"; do
  command -v "$t" >/dev/null 2>&1 || missing_required+=("$t")
done

missing_config=()
for t in "${config_tools[@]}"; do
  command -v "$t" >/dev/null 2>&1 || missing_config+=("$t")
done

if ((${#missing_required[@]})); then
  err "Missing tools required to bootstrap: ${missing_required[*]}"
  err "Install them and re-run (e.g. sudo pacman -S ${missing_required[*]})."
  exit 1
fi

if ((${#missing_config[@]})); then
  warn "Tools referenced by your zsh config that are not installed:"
  for t in "${missing_config[@]}"; do warn "  - $t"; done
  warn "zsh will still start, but those features (or lines) may error until you install them."
fi

# ---------- 2. oh-my-zsh ----------
if [[ -d "$ZSH" ]]; then
  info "oh-my-zsh already present at $ZSH"
else
  info "Installing oh-my-zsh..."
  # RUNZSH=no: don't drop us into a new shell; KEEP_ZSHRC=yes / --keep-zshrc:
  # never overwrite this repo's .zshrc; --unattended: no shell switch / prompts.
  RUNZSH=no KEEP_ZSHRC=yes sh -c \
    "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" \
    "" --unattended --keep-zshrc
fi

# ---------- 3. powerlevel10k theme ----------
# .zshrc sets ZSH_THEME="powerlevel10k/powerlevel10k"; the theme is not bundled
# with oh-my-zsh, so it must be cloned into the custom themes dir.
p10k_dir="$ZSH_CUSTOM/themes/powerlevel10k"
if [[ -d "$p10k_dir" ]]; then
  info "powerlevel10k already present; updating..."
  git -C "$p10k_dir" pull --ff-only --quiet || warn "could not update powerlevel10k"
else
  info "Installing powerlevel10k..."
  git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$p10k_dir"
fi

# ---------- 4. link dotfiles ----------
info "Linking dotfiles..."
"$repo_dir/dotfiles" setup

# ---------- 5. login shell ----------
zsh_path="$(command -v zsh)"
if [[ "${SHELL:-}" != "$zsh_path" ]]; then
  warn "Your login shell is '${SHELL:-unknown}', not '$zsh_path'."
  warn "Set it with: chsh -s $zsh_path"
fi

info "Done. Open a new terminal or run: exec zsh"
